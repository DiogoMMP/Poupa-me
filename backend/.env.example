# Exemplo das variáveis de ambiente do backend. Copiar para .env e preencher.
# Nunca pôr valores reais neste ficheiro: ele vai para o git.

# --- Servidor ---
PORT=3000
# development | production (em production correm as migrations e o synchronize fica desligado)
NODE_ENV=development
LOG_LEVEL=info
# Origem do frontend para o CORS
FRONTEND_URL=http://localhost:4200

# --- Base de dados (obrigatório fora de desenvolvimento) ---
# Formato: postgresql://utilizador:password@host:porta/nome_da_base_de_dados
POSTGRES_URL=
# Alternativa ao POSTGRES_URL (usada pelo docker-compose)
# DATABASE_URL=

# --- Segurança ---
# Strings longas e aleatórias
JWT_SECRET=
JWT_EXPIRES_IN=1h
SESSION_SECRET=

# --- Categorização automática (IA) ---
# Token Hugging Face: inferência (camada LLM) e leitura do Space privado do categorizador
HF_TOKEN=
# Modelo do LLM; tem de ser servido por um dos Inference Providers ativos na conta HF
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
# Space do modelo próprio ("owner/nome" ou URL, p.ex. http://localhost:7860). Vazio = camada do modelo desligada
HF_SPACE_ID=
# Tempo máximo de espera pelo Space, em ms
IA_SPACE_TIMEOUT_MS=8000
# Confiança mínima (0 a 1) para aceitar a sugestão do modelo
IA_LIMIAR_CONFIANCA=0.6
# Categorias nunca sugeridas (nomes separados por vírgulas, sem diferença de maiúsculas nem acentos)
IA_CATEGORIAS_EXCLUIDAS=Outros,Sem Categoria
